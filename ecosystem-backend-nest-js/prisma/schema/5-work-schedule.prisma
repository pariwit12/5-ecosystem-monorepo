// 3. สร้าง Admin (ผู้ดูแลเรื่องตารางเวร ของ สถานที่ทำงาน)
model WorkScheduleAdmin {
  personId                        String                        @map("person_id") @db.Uuid
  person                          Person                        @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationWorkSchedulePlaceId String                        @map("organization_work_schedule_place_id") @db.Uuid
  organizationWorkSchedulePlace   OrganizationWorkSchedulePlace @relation(fields: [organizationWorkSchedulePlaceId], references: [id], onDelete: Restrict)
  deletedAt                       DateTime?                     @map("deleted_at")

  @@id([personId, organizationWorkSchedulePlaceId])
  @@index([organizationWorkSchedulePlaceId])
  @@map("work_schedule_admin")
}

// 4. สร้างตำแหน่งงานต่างๆ
model WorkSchedulePosition {
  id                              String                        @id @default(uuid(7)) @db.Uuid
  organizationWorkSchedulePlaceId String                        @map("organization_work_schedule_place_id") @db.Uuid
  organizationWorkSchedulePlace   OrganizationWorkSchedulePlace @relation(fields: [organizationWorkSchedulePlaceId], references: [id], onDelete: Restrict)
  deletedAt                       DateTime?                     @map("deleted_at")

  name String // เช่น "ทันตแพทย์", "พยาบาล", "แอดมิน"

  workScheduleSlotTemplates  WorkScheduleSlotTemplate[]
  workScheduleSlots          WorkScheduleSlot[]
  workScheduleStaffPositions WorkScheduleStaffPosition[]

  @@index([organizationWorkSchedulePlaceId])
  @@map("work_schedule_position")
}

// 5. สร้าง Template ให้ Admin ใช้สร้าง Slot ง่ายๆ
model WorkScheduleSlotTemplate {
  id                     String               @id @default(uuid(7)) @db.Uuid
  workSchedulePositionId String               @map("work_schedule_position_id") @db.Uuid
  workSchedulePosition   WorkSchedulePosition @relation(fields: [workSchedulePositionId], references: [id], onDelete: Restrict)

  name           String // เช่น "เวรเช้า (M)", "เวรบ่าย (A)", "เวรดึก (N)", "กะเปิดร้าน"
  // 🌟 เก็บเป็น String (Wall-clock Time) เสมอ! ห้ามเก็บเป็น DateTime เด็ดขาด (โยนเรื่อง timezone ไปให้ OrganizationWorkSchedulePlace เก็บ)
  startTime      String @map("start_time") // "20:00"
  durationMinute Int    @map("duration_minute") // 720 (นาที)
  quantity       Int    @default(1) // จำนวน Slot ที่จะสร้าง

  //   colorCode   String?   @map("color_code") // เอาไว้ให้หน้าบ้านระบายสีปฏิทินสวยๆ

  @@index([workSchedulePositionId])
  @@map("work_schedule_slot_template")
}

// 6. สร้าง Slot จริง ให้ Staff มาลง หรือ admin จัดใส่ให้
model WorkScheduleSlot {
  id                        String                     @id @default(uuid(7)) @db.Uuid
  workSchedulePositionId    String                     @map("work_schedule_position_id") @db.Uuid
  workSchedulePosition      WorkSchedulePosition       @relation(fields: [workSchedulePositionId], references: [id], onDelete: Restrict)
  // คนที่มาลง Slot
  workScheduleStaffId       String?                    @map("work_schedule_staff_id") @db.Uuid
  // relation จาก workScheduleStaffId ไป WorkScheduleStaff จะใส่หรือไม่ใส่ก็ได้ ถ้าใส่ DX จะดีขึ้น แต่ถ้าไม่ใส่จะถูกหลักมากกว่า
  workScheduleStaffPosition WorkScheduleStaffPosition? @relation(fields: [workScheduleStaffId, workSchedulePositionId], references: [workScheduleStaffId, workSchedulePositionId], onDelete: Restrict)

  name            String // เช่น "เวรเช้า (M)", "เวรบ่าย (A)", "เวรดึก (N)", "กะเปิดร้าน"
  // ตอนสร้างก็ให้ประกอบร่าง datetime และไปเอา timezone จาก OrganizationWorkSchedulePlace มาประกอบการสร้าง
  // ตอนแสดงให้ไปเอา timezone จาก OrganizationWorkSchedulePlace มาประกอบการแสดงเวลา
  actualStartTime DateTime @map("actual_start_time") @db.Timestamptz
  actualEndTime   DateTime @map("actual_end_time") @db.Timestamptz

  //   status          String    @default("OPEN") // PENDING, PUBLISHED, CANCELED
  //   note            String? // Description

  // ช่วยออกแบบว่าควรใส่ index อย่างไรบ้างครับ
  @@index([workSchedulePositionId, actualStartTime])
  @@index([workScheduleStaffId, actualStartTime])
  @@map("work_schedule_slot")
}

// 7. สร้างพนักงานของ OrganizationWorkSchedulePlace
model WorkScheduleStaff {
  id                              String                        @id @default(uuid(7)) @db.Uuid
  organizationWorkSchedulePlaceId String                        @map("organization_work_schedule_place_id") @db.Uuid
  organizationWorkSchedulePlace   OrganizationWorkSchedulePlace @relation(fields: [organizationWorkSchedulePlaceId], references: [id], onDelete: Restrict)
  // เผื่อผูก User จะขอผูกบัญชีกับโปรแกรม Work-Schedule ของ OrganizationWorkSchedulePlace
  personId                        String?                       @map("person_id") @db.Uuid
  person                          Person?                       @relation(fields: [personId], references: [id], onDelete: Restrict)
  deletedAt                       DateTime?                     @map("deleted_at")

  name String // ชื่อพนักงาน (โดย OrganizationWorkSchedulePlace)
  //   role        String    @default("STAFF") // เช่น "HEAD_NURSE", "NURSE", "PART_TIME"
  //   isActive    Boolean   @default(true) @map("is_active")

  workScheduleStaffPositions WorkScheduleStaffPosition[]

  @@index([organizationWorkSchedulePlaceId])
  @@index([personId])
  @@map("work_schedule_staff")
}

// 8. สร้างตำแหน่งให้ Staff เพื่อจะนำไปใช้ลง Slot ได้ตรงตำแหน่งตัวเอง
model WorkScheduleStaffPosition {
  workScheduleStaffId    String               @map("work_schedule_staff_id") @db.Uuid
  workScheduleStaff      WorkScheduleStaff    @relation(fields: [workScheduleStaffId], references: [id], onDelete: Restrict)
  workSchedulePositionId String               @map("work_schedule_position_id") @db.Uuid
  workSchedulePosition   WorkSchedulePosition @relation(fields: [workSchedulePositionId], references: [id], onDelete: Restrict)
  deletedAt              DateTime?            @map("deleted_at")

  workScheduleSlots WorkScheduleSlot[]

  @@id([workScheduleStaffId, workSchedulePositionId]) // ป้องกันไม่ให้แอดพนักงานคนเดิมซ้ำในตำแหน่งเดิม
  @@index([workSchedulePositionId])
  @@map("work_schedule_staff_position")
}
