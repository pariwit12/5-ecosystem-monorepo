// 1. สร้างสถานที่ทำงาน
model OrganizationWorkSchedulePlace {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deletedAt      DateTime?    @map("deleted_at")
  // // 2. บอกวันหมดอายุ (รอเปลี่ยนเป็น moduleOneSubscriptionEndDate โดย ถ้า null แปลว่ายังไม่ได้สมัคร)
  // subscriptionEndDate DateTime?    @map("subscription_end_date")

  // 🌟 บังคับใส่ Timezone มาตรฐาน IANA เสมอ (เช่น "Asia/Bangkok", "Europe/London")
  timezone String // @default("Asia/Bangkok") // เอาไว้บอกว่าต้องแสดงข้อมูล ในโมดูลนี้ด้วย timezone ไหน

  name String // เช่น "คลินิกสาขาอารีย์", "วอร์ดพยาบาลผู้ป่วยใน ICU"

  // version    Int @default(1)
  // // ใช้สำหรับ
  // // 1. 

  // workScheduleAdminInvitationRequests WorkScheduleAdminInvitationRequest[] (ระบบเชิญ admin ค่อยทำทีหลัง)
  workScheduleAdmins                  WorkScheduleAdmin[]
  workSchedulePositions               WorkSchedulePosition[]
  workScheduleStaffs                  WorkScheduleStaff[]

  @@index([organizationId])
  @@map("organization_work_schedule_place")
}

