// 3. สร้าง Admin (ผู้ดูแลเรื่องตารางเวร ของ สถานที่ทำงาน)
model WorkScheduleAdmin {
  personId                        String                        @map("person_id") @db.Uuid
  person                          Person                        @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationWorkSchedulePlaceId String                        @map("organization_work_schedule_place_id") @db.Uuid
  organizationWorkSchedulePlace   OrganizationWorkSchedulePlace @relation(fields: [organizationWorkSchedulePlaceId], references: [id], onDelete: Restrict)
  deletedAt                       DateTime?                     @map("deleted_at")

  @@id([personId, organizationWorkSchedulePlaceId])
  @@index([organizationWorkSchedulePlaceId])
  @@map("work_schedule_admin")
}

// 7. สร้างพนักงานของ OrganizationWorkSchedulePlace
model WorkScheduleStaff {
  id                              String                        @id @default(uuid(7)) @db.Uuid
  organizationWorkSchedulePlaceId String                        @map("organization_work_schedule_place_id") @db.Uuid
  organizationWorkSchedulePlace   OrganizationWorkSchedulePlace @relation(fields: [organizationWorkSchedulePlaceId], references: [id], onDelete: Restrict)
  // เผื่อผูก User จะขอผูกบัญชีกับโปรแกรม Work-Schedule ของ OrganizationWorkSchedulePlace
  personId                        String?                       @map("person_id") @db.Uuid
  person                          Person?                       @relation(fields: [personId], references: [id], onDelete: Restrict)
  deletedAt                       DateTime?                     @map("deleted_at")

  name String // ชื่อพนักงาน (สำหรับ OrganizationWorkSchedulePlace)

  workScheduleStaffPositions WorkScheduleStaffPosition[]
  workScheduleStaffInvitations WorkScheduleStaffInvitation[]
  workScheduleStaffLinkAudits  WorkScheduleStaffLinkAudit[]
  workScheduleHolidays         WorkScheduleHoliday[]

  @@unique([organizationWorkSchedulePlaceId, personId])
  // 🌟 2. เราไม่ต้องมี @@index ของ organizationWorkSchedulePlaceId แล้ว เพราะตัว unique ข้างบนจัดการให้แล้ว
  // @@index([organizationWorkSchedulePlaceId])
  @@index([personId])
  @@map("work_schedule_staff")
}

// 4. สร้างตำแหน่งงานต่างๆ
model WorkSchedulePosition {
  id                              String                        @id @default(uuid(7)) @db.Uuid
  organizationWorkSchedulePlaceId String                        @map("organization_work_schedule_place_id") @db.Uuid
  organizationWorkSchedulePlace   OrganizationWorkSchedulePlace @relation(fields: [organizationWorkSchedulePlaceId], references: [id], onDelete: Restrict)
  deletedAt                       DateTime?                     @map("deleted_at")

  name String // เช่น "พยาบาล วอร์ดอายุรกรรมชั้น 4"

  workScheduleMinMaxs        WorkScheduleMinMax[]
  workScheduleStaffPositions WorkScheduleStaffPosition[]
  slotTypes                  WorkScheduleSlotType[]
  workScheduleSlotTemplates  WorkScheduleSlotTemplate[]
  slots                      WorkScheduleSlot[]

  @@index([organizationWorkSchedulePlaceId])
  @@map("work_schedule_position")
}

// 8. สร้างตำแหน่งให้ Staff เพื่อจะนำไปใช้ลง Slot ได้ตรงตำแหน่งตัวเอง
model WorkScheduleStaffPosition {
  workScheduleStaffId    String               @map("work_schedule_staff_id") @db.Uuid
  workScheduleStaff      WorkScheduleStaff    @relation(fields: [workScheduleStaffId], references: [id], onDelete: Restrict)
  workSchedulePositionId String               @map("work_schedule_position_id") @db.Uuid
  workSchedulePosition   WorkSchedulePosition @relation(fields: [workSchedulePositionId], references: [id], onDelete: Restrict)
  deletedAt              DateTime?            @map("deleted_at")

  slots WorkScheduleSlot[]

  @@id([workScheduleStaffId, workSchedulePositionId]) // ป้องกันไม่ให้แอดพนักงานคนเดิมซ้ำในตำแหน่งเดิม
  @@index([workSchedulePositionId])
  @@map("work_schedule_staff_position")
}

// 9. กำหนดจำนวนพนักงานขั้นต่ำ / สูงสุด
model WorkScheduleMinMax {
  id                     String               @id @default(uuid(7)) @db.Uuid
  workSchedulePositionId String               @map("work_schedule_position_id") @db.Uuid
  workSchedulePosition   WorkSchedulePosition @relation(fields: [workSchedulePositionId], references: [id], onDelete: Restrict)

  min       Int? // ค่า >= 0 (ควร Validate ระดับ Code ก่อน Save)
  max       Int? // ค่า >= 0 (ควร Validate ระดับ Code ก่อน Save)
  startTime DateTime @map("start_time") @db.Timestamptz
  endTime   DateTime @map("end_time") @db.Timestamptz

  // Index สำหรับเพิ่มความเร็วเวลา Query หาช่วงเวลาที่คาบเกี่ยวกัน (Overlap)
  @@index([workSchedulePositionId, startTime, endTime])
  @@map("work_schedule_min_max")
}

// Tag Slot: เพื่อใช้สำหรับการนับเวรแต่ละประเภท, แสดงผล หรือ ระบบ auto ในการจัดตารางเวร
model WorkScheduleSlotType {
  id         String               @id @default(uuid(7)) @db.Uuid
  positionId String               @map("position_id") @db.Uuid
  position   WorkSchedulePosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  deletedAt  DateTime?            @map("deleted_at")

  name String // เช่น "เวรเช้า (M)", "เวรบ่าย (A)", "เวรดึก (N)", "กะเปิดร้าน"

  slotTemplates WorkScheduleSlotTemplate[]
  slots         WorkScheduleSlot[]

  @@map("work_schedule_slot_type")
}

// 5. สร้าง Template ให้ Admin ใช้สร้าง Slot ง่ายๆ
model WorkScheduleSlotTemplate {
  id                     String               @id @default(uuid(7)) @db.Uuid
  workSchedulePositionId String               @map("work_schedule_position_id") @db.Uuid
  workSchedulePosition   WorkSchedulePosition @relation(fields: [workSchedulePositionId], references: [id], onDelete: Restrict)
  slotTypeId             String               @map("slot_type_id") @db.Uuid
  slotType               WorkScheduleSlotType @relation(fields: [slotTypeId], references: [id], onDelete: Restrict)

  name           String // เช่น แบบร่างเวรเช้า
  startTime      String @map("start_time") // "20:00"
  durationMinute Int    @map("duration_minute") // 720 (นาที)

  //   colorCode   String?   @map("color_code") // เอาไว้ให้หน้าบ้านระบายสีปฏิทินสวยๆ

  @@index([workSchedulePositionId])
  @@map("work_schedule_slot_template")
}

// 6. สร้าง Slot จริง ให้ Staff มาลง หรือ admin จัดใส่ให้
model WorkScheduleSlot {
  id            String                    @id @default(uuid(7)) @db.Uuid
  positionId    String                    @map("position_id") @db.Uuid
  position      WorkSchedulePosition      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  staffId       String                    @map("staff_id") @db.Uuid
  // relation จาก workScheduleStaffId ไป WorkScheduleStaff จะใส่หรือไม่ใส่ก็ได้ ถ้าใส่ DX จะดีขึ้น แต่ถ้าไม่ใส่จะถูกหลักมากกว่า
  staffPosition WorkScheduleStaffPosition @relation(fields: [staffId, positionId], references: [workScheduleStaffId, workSchedulePositionId], onDelete: Restrict)
  slotTypeId    String                    @map("slot_type_id") @db.Uuid
  slotType      WorkScheduleSlotType      @relation(fields: [slotTypeId], references: [id], onDelete: Restrict)

  note String? // Description

  // ตอนสร้างก็ให้ประกอบร่าง datetime และไปเอา timezone จาก OrganizationWorkSchedulePlace มาประกอบการสร้าง
  // ตอนแสดงให้ไปเอา timezone จาก OrganizationWorkSchedulePlace มาประกอบการแสดงเวลา
  actualStartTime DateTime @map("actual_start_time") @db.Timestamptz
  actualEndTime   DateTime @map("actual_end_time") @db.Timestamptz

  // ช่วยออกแบบว่าควรใส่ index อย่างไรบ้างครับ
  @@index([positionId, actualStartTime])
  @@index([staffId, actualStartTime])
  @@map("work_schedule_slot")
}

enum WorkScheduleStaffInvitationStatus {
  ISSUED
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum WorkScheduleStaffLinkAuditAction {
  LINK
  UNLINK
}

model WorkScheduleStaffInvitation {
  id                  String                            @id @default(uuid(7)) @db.Uuid
  staffId             String                            @map("staff_id") @db.Uuid
  staff               WorkScheduleStaff                 @relation(fields: [staffId], references: [id], onDelete: Restrict)
  codeHash            String                            @unique @map("code_hash")
  status              WorkScheduleStaffInvitationStatus @default(ISSUED)
  createdByPersonId   String                            @map("created_by_person_id") @db.Uuid
  createdByPerson     Person                            @relation("WorkScheduleStaffInvitationCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  requestedByPersonId String?                           @map("requested_by_person_id") @db.Uuid
  requestedByPerson   Person?                           @relation("WorkScheduleStaffInvitationRequester", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  decidedByPersonId   String?                           @map("decided_by_person_id") @db.Uuid
  decidedByPerson     Person?                           @relation("WorkScheduleStaffInvitationDecider", fields: [decidedByPersonId], references: [id], onDelete: Restrict)
  createdAt           DateTime                          @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime                          @map("expires_at") @db.Timestamptz
  requestedAt         DateTime?                         @map("requested_at") @db.Timestamptz
  decidedAt           DateTime?                         @map("decided_at") @db.Timestamptz
  revokedAt           DateTime?                         @map("revoked_at") @db.Timestamptz

  workScheduleStaffLinkAudits WorkScheduleStaffLinkAudit[]

  @@index([staffId])
  @@index([requestedByPersonId])
  @@map("work_schedule_staff_invitation")
}

model WorkScheduleStaffLinkAudit {
  id             String                           @id @default(uuid(7)) @db.Uuid
  staffId        String                           @map("staff_id") @db.Uuid
  staff          WorkScheduleStaff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  personId       String                           @map("person_id") @db.Uuid
  person         Person                           @relation("WorkScheduleStaffLinkAuditPerson", fields: [personId], references: [id], onDelete: Restrict)
  actorPersonId  String                           @map("actor_person_id") @db.Uuid
  actorPerson    Person                           @relation("WorkScheduleStaffLinkAuditActor", fields: [actorPersonId], references: [id], onDelete: Restrict)
  invitationId   String?                          @map("invitation_id") @db.Uuid
  invitation     WorkScheduleStaffInvitation?     @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  action         WorkScheduleStaffLinkAuditAction
  createdAt      DateTime                         @default(now()) @map("created_at") @db.Timestamptz

  @@index([staffId, createdAt])
  @@map("work_schedule_staff_link_audit")
}

model WorkScheduleHoliday {
  id                  String            @id @default(uuid(7)) @db.Uuid
  workScheduleStaffId String            @map("work_schedule_staff_id") @db.Uuid
  workScheduleStaff   WorkScheduleStaff @relation(fields: [workScheduleStaffId], references: [id], onDelete: Restrict)
  startTime           DateTime          @map("start_time") @db.Timestamptz
  endTime             DateTime          @map("end_time") @db.Timestamptz
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([workScheduleStaffId, startTime, endTime])
  @@map("work_schedule_holiday")
}
