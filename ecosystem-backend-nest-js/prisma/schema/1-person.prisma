// ------------------------------------------------------
// โมดูลเก็บข้อมูลส่วนกลาง (หลัง log-in)
// ------------------------------------------------------

model Organization {
  id        String    @id @default(uuid(7)) @db.Uuid
  // ใช้ deleted_at เพื่อให้รู้เวลาที่ลบ (ถ้าเป็น null คือยังไม่ลบ)
  deletedAt DateTime? @map("deleted_at")

  name String

  version Int @default(1)
  // ใช้สำหรับ
  // 1. เปลี่ยนแปลงข้อมูล Organization
  // 2. สร้าง + เปลี่ยนแปลงข้อมูล OrganizationDentalClinic

  personOrganizationAffiliations PersonOrganizationAffiliation[]

  organizationDentalClinics      OrganizationDentalClinic[]
  organizationWorkSchedulePlaces OrganizationWorkSchedulePlace[]

  @@map("organization")
}

model Person {
  id            String       @id @default(uuid(7)) @db.Uuid
  userAccountId String?      @unique @map("user_account_id") @db.Uuid
  userAccount   UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Restrict)

  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  nickname  String?
  phone     String?
  birthDate DateTime? @map("birth_date") @db.Date

  version Int @default(1)
  // ใช้สำหรับ
  // 1. เปลี่ยนแปลงข้อมูล Person
  // 2. สร้าง + เปลี่ยนแปลงข้อมูล Organization (หน้าจัดการองค์กร)

  personOrganizationAffiliations PersonOrganizationAffiliation[]
  legacyIdentities               PersonLegacyIdentity[]
  identityDocuments              PersonIdentityDocument[]
  dentist                        PersonDentist?
  staff                          PersonStaff?
  dentalPatient                  PersonDentalPatient?
  // workScheduleAdminInvitationRequests WorkScheduleAdminInvitationRequest[] (ระบบเชิญ admin ค่อยทำทีหลัง)
  workScheduleAdmins             WorkScheduleAdmin[]
  workScheduleStaffs             WorkScheduleStaff[]
  staffInvitationsCreated        StaffInvitation[]               @relation("StaffInvitationCreator")
  staffInvitationsTargeted       StaffInvitation[]               @relation("StaffInvitationTarget")
  staffInvitationsUsed           StaffInvitation[]               @relation("StaffInvitationUser")
  // personDentist       PersonDentist?
  // personDentalPatient PersonDentalPatient?

  @@map("person")
}

enum IdentityDocumentType {
  THAI_CID
  PASSPORT
  FOREIGN_ID
  OTHER
}

model PersonIdentityDocument {
  personId        String               @map("person_id") @db.Uuid
  person          Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  type            IdentityDocumentType
  issuingCountry  String               @map("issuing_country") @db.Char(2)
  normalizedValue String               @map("normalized_value") @db.VarChar(100)
  expiresAt       DateTime?            @map("expires_at") @db.Date

  @@id([personId, type, issuingCountry, normalizedValue])
  @@unique([type, issuingCountry, normalizedValue])
  @@map("person_identity_document")
}

model UserAccount {
  id      String  @id @default(uuid(7)) @db.Uuid
  clerkId String  @unique @map("clerk_id")
  person  Person?

  @@map("user_account")
}

model PersonDentist {
  personId      String  @id @map("person_id") @db.Uuid
  person        Person  @relation(fields: [personId], references: [id], onDelete: Restrict)
  licenseNumber String? @unique @map("license_number")
  legacyRole    String? @map("legacy_role")

  clinicAffiliations PersonDentistAffiliation[]

  @@map("person_dentist")
}

model PersonStaff {
  personId String @id @map("person_id") @db.Uuid
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  clinicAffiliations PersonStaffAffiliation[]

  @@map("person_staff")
}

enum StaffRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  DENTAL_ASSISTANT
  ACCOUNTING
  OTHER
}

model PersonDentalPatient {
  personId           String                           @id @map("person_id") @db.Uuid
  person             Person                           @relation(fields: [personId], references: [id], onDelete: Restrict)
  legacyPatientId    Int?                             @unique @map("legacy_patient_id")
  clinicAffiliations PersonDentalPatientAffiliation[]

  @@map("person_dental_patient")
}

model PersonLegacyIdentity {
  id         String @id @default(uuid(7)) @db.Uuid
  personId   String @map("person_id") @db.Uuid
  person     Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  source     String
  entityType String @map("entity_type")
  legacyId   Int    @map("legacy_id")

  @@unique([source, entityType, legacyId])
  @@index([personId])
  @@map("person_legacy_identity")
}

model PersonOrganizationAffiliation {
  personId       String           @map("person_id") @db.Uuid
  person         Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           OrganizationRole @default(MEMBER)

  // 🔥 ใช้ id เป็น Composite PK (ป้องกันการแอดซ้ำ และเป็นดัชนีที่เร็วที่สุด)
  @@id([personId, organizationId]) // = เร็วตัวแรก และ 2 ตัว (ตัวที่ไม่อยู่ตามลำดับจากด้านซ้ายจะช้า ต้องไปทำ index เพิ่มถ้าต้องใช้ในการค้นหา)
  // 🌟 สร้างทางด่วนแยกให้ตัวหลัง (เพราะบางครั้งเราอยากค้นหาจากฝั่งหลังตัวเดียว)
  @@index([organizationId])
  @@map("person_organization_affiliation")
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

